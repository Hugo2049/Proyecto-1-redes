# Copy this file to .env and fill in your own key. Never commit the real .env.
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-5

# Set to 0/false to disable a server if the required runtime is missing.
CHATBOT_ENABLE_CLINIC=1
CHATBOT_ENABLE_FILESYSTEM=1
CHATBOT_ENABLE_GIT=1

# Remote (Cloudflare Workers) deployment of the clinic server. Off by default
# since it duplicates the local 'clinic' server's tools under a different name.
CHATBOT_ENABLE_CLINIC_REMOTE=0
CLINIC_REMOTE_URL=https://clinic-appointment-mcp-remote.hugomcp.workers.dev/

# Sandbox directory exposed to the filesystem/git MCP servers.
# MCP_WORKSPACE_DIR=C:/path/to/chatbot/workspace
